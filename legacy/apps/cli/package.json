{
  "name": "@paw/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "已归档：原 CLI 应用。共享的 Paw Next V3 组装入口已迁出到 packages/paw-next（@paw/paw-next）。本包不在 workspace 内，仅供查阅。",
  "pawLegacy": true,
  "bin": {
    "paw-ts": "./src/main.ts"
  },
  "dependencies": {
    "playwright": "^1.62.1",
    "@paw/agent": "workspace:*",
    "@paw/agent-loop": "workspace:*",
    "@paw/core": "workspace:*",
    "@paw/context-compaction": "workspace:*",
    "@paw/completion-review": "workspace:*",
    "@paw/collaboration": "workspace:*",
    "@paw/harness": "workspace:*",
    "@paw/memory": "workspace:*",
    "@paw/memory-plugin": "workspace:*",
    "@paw/model-output-recovery": "workspace:*",
    "@paw/models": "workspace:*",
    "@paw/output-recall": "workspace:*",
    "@paw/paw-next": "workspace:*",
    "@paw/protocol": "workspace:*",
    "@paw/progress-advisor": "workspace:*",
    "@paw/runtime": "workspace:*",
    "@paw/settings": "workspace:*",
    "@paw/task-progress": "workspace:*",
    "@paw/web-access": "workspace:*",
    "@paw/workspace": "workspace:*"
  },
  "scripts": {
    "test": "bun test test",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "smoke:kv-cache": "bun test/paw-next-kv-cache-smoke.driver.ts",
    "smoke:kv-cache:child-prefix": "bun test/paw-child-prefix-cache-smoke.driver.ts",
    "start": "bun run src/main.ts"
  }
}
