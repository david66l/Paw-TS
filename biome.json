{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignore": ["../claude-code/**", "../src/paw/**", "dist/**", "node_modules/**", "legacy/**"]
  },
  "organizeImports": { "enabled": true },
  "css": {
    "parser": { "cssModules": true }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "noUselessFragments": "error", "useLiteralKeys": "warn" },
      "correctness": { "noUnusedImports": "error", "useExhaustiveDependencies": "warn" },
      "style": {
        "noNonNullAssertion": "warn",
        "useConst": "error",
        "useTemplate": "warn",
        "noUnusedTemplateLiteral": "warn",
        "useSingleVarDeclarator": "warn"
      },
      "suspicious": { "noExplicitAny": "warn" }
    }
  },
  "overrides": [
    {
      "include": ["**/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "performance": { "noDelete": "off" }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  }
}
