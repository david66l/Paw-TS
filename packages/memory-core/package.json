{
  "name": "@paw/memory-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime-independent, evidence-first long-term memory core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david66l/Paw-TS.git",
    "directory": "packages/memory-core"
  },
  "keywords": [
    "agent-memory",
    "evidence",
    "long-term-memory",
    "rag",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./legacy": "./src/legacy.ts",
    "./public": "./src/public-api.ts",
    "./canonical": "./src/canonical.ts",
    "./context-contract": "./src/context-contract.ts",
    "./evidence-context-adapter": "./src/evidence-context-adapter.ts",
    "./evidence-answer-policy": "./src/evidence-answer-policy.ts",
    "./evidence-closure-auditor": "./src/evidence-closure-auditor.ts",
    "./evidence-first": "./src/evidence-first.ts",
    "./evidence-index-adapter": "./src/evidence-index-adapter.ts",
    "./evidence-ref": "./src/evidence-ref.ts",
    "./evidence-query-planner": "./src/evidence-query-planner.ts",
    "./evidence-resolver": "./src/evidence-resolver.ts",
    "./evidence-support-selector": "./src/evidence-support-selector.ts",
    "./source-local-evidence-locator": "./src/source-local-evidence-locator.ts",
    "./in-memory-store": "./src/in-memory-store.ts",
    "./model-port": "./src/model-port.ts",
    "./product-ports": "./src/product-ports.ts",
    "./state-observation": "./src/state-observation.ts"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun test",
    "example": "bun run examples/basic.ts",
    "format": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "bun-types": "^1.3.13",
    "typescript": "^5.7.3"
  }
}
