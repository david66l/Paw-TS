{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "dist",
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@paw/agent-loop": ["packages/agent-loop/src/index.ts"],
      "@paw/core": ["packages/core/src/index.ts"],
      "@paw/harness": ["packages/harness/src/index.ts"],
      "@paw/memory": ["packages/memory/src/index.ts"],
