    "passes": false,
    "e2e": {
      "actions": [
        { "type": "goto", "path": "/" },
        { "type": "fill", "selector": "[data-testid=todo-input]", "value": "keep" },
        { "type": "click", "selector": "[data-testid=todo-add]" },
        { "type": "fill", "selector": "[data-testid=todo-input]", "value": "drop" },
        { "type": "click", "selector": "[data-testid=todo-add]" },
        { "type": "click", "selector": "[data-testid=todo-item]:has-text('drop')" },
        { "type": "click", "selector": "[data-testid=clear-completed]" },
        { "type": "expect_text", "selector": "[data-testid=todo-list]", "text": "keep" },
        { "type": "expect_count", "selector": "[data-testid=todo-item]", "count": 1 }
      ]
    }
  },
  {
    "id": "todo-input-clears",
    "category": "ux",
