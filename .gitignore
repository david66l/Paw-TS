# paw-ts — local / sensitive (never commit)
#
# Canonical paths used by @paw/settings and @paw/core:
#   .paw/settings.local.json   — API keys, base URLs, MCP server env
#   .paw/CLAUDE.local.md       — local-only project prefs
#   .paw/sessions/*.jsonl      — run traces (may contain prompts / tool I/O)
#   .paw/checkpoints/          — file snapshots for undo
#   .paw/states/               — persisted run / app state
#
# 注意：用 `.paw/*`（而非 `.paw/`）忽略目录内容，以便下方可以
# 重新包含个别子目录（git 不允许重新包含被排除目录下的文件）。
.paw/*
# 记忆机制 v2（文档/记忆机制spec-v2 04 §4.1）：
#   .paw/memory/         — 远期 file 后端的个人记忆库，永不进 git（默认项先行）
#   .paw/shared-memory/  — `paw-ts memory export` 的显式导出目录，可提交（已过密钥扫描）
.paw/memory/

# 嵌套 .paw（如 apps/tui/.paw/）同理为本地运行态，永不进 git。
# 用 `**/.paw/*`（忽略内容而非目录本身），下方例外才能重新包含。
**/.paw/*

# shared-memory 例外放行（必须在所有忽略规则之后才能生效）
!.paw/shared-memory/
!**/.paw/shared-memory/

# Optional dev env at monorepo subfolder
.env
.env.*
!.env.example

# macOS
.DS_Store

# Backups / temp
*.bak
*.current

# Build outputs
.next/
dist/
build/

# Dependencies
node_modules/

# Personal / interview materials (not product source)
面试/
简历*.md
大厂筛选*.md

# Local design / research docs (not product source)
文档/

# Local sandboxes and scratch projects
personal-site/
temp-site/
测试project/
web-project/
/memory/
index.html
training_data/stage_c_deepseek_teacher.jsonl
training_data/*.jsonl

# Long-run harness workspaces / reports
benchmarks/longrun-harness/.workspace/
benchmarks/longrun-harness/runs/
benchmarks/longrun-harness/last-run.json

# Downloaded benchmark datasets / generated Hugging Face caches
benchmarks/memory-agent-bench/hf-dataset/
benchmarks/memory-agent-bench/hf-cache/*
!benchmarks/memory-agent-bench/hf-cache/.gitkeep
benchmarks/swe-bench/swe-bench-lite.jsonl
benchmarks/swe-bench/swe-bench-verified.jsonl
benchmarks/swe-exp/repos/
benchmarks/swe-exp/runs/
benchmarks/swe-exp/last-run.json
benchmarks/swe-compare/preflight/
benchmarks/swe-compare/runs/
benchmarks/swe-compare/capability-shadow-smoke/runs/
benchmarks/swe-compare/capability-shadow-smoke/deterministic-*/
benchmarks/swe-compare/shadow-reports/
benchmarks/swe-compare/*.jsonl
benchmarks/swe-compare/manifests/
benchmarks/swe-compare/runtime/

# Official SWE-bench writes schema-v2 summary JSON files at the repository root.
/swe-compare-preflight-*.json
/preflight-*.swecompare-preflight-*.json
/swe-compare-paw.*.json
/swe-compare-claude.*.json

# Generated benchmark logs / reports (source harnesses and fixtures are kept)
logs/
benchmarks/**/*.log
benchmarks/memory-agent-bench/last-run*.json
benchmarks/memory-mechanism/last-run.json
/paw-capability-first*.json
/paw-ts-memory-*.json

# Python/runtime scratch
__pycache__/
*.pyc
/.cursor-tasklifecycle-plan-extract.md
/hello.txt
